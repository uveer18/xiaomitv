<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home">

    <!-- Ambient bloom: the focused app's colour bleeding into the backdrop -->
    <View
        android:id="@+id/ambientBloom"
        android:layout_width="match_parent"
        android:layout_height="700dp"
        android:layout_gravity="bottom" />

    <!-- Fade behind the top bar -->
    <View
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:layout_gravity="top"
        android:background="@drawable/scrim_top" />

    <!-- Subtle brand glow behind the dock: gentle accent, not screen-washing gradient -->
    <View
        android:id="@+id/dockStrip"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_gravity="bottom"
        android:alpha="0" />

    <!-- Content Showcase Shelf: key art for the focused dock app -->
    <LinearLayout
        android:id="@+id/shelfContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="150dp"
        android:paddingStart="36dp"
        android:paddingEnd="36dp"
        android:orientation="vertical"
        android:alpha="0"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Shelf Header: the focused app and what the rail holds -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp"
            android:paddingStart="2dp">

            <View
                android:id="@+id/shelfAccentDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/badge_dot"
                android:layout_marginEnd="10dp" />

            <TextView
                android:id="@+id/shelfAppTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textColor="#FFFFFFFF"
                android:textSize="21sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 600"
                android:letterSpacing="0.02" />

            <TextView
                android:id="@+id/shelfSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textColor="#8CFFFFFF"
                android:textSize="10sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 500"
                android:letterSpacing="0.16"
                android:textAllCaps="true"
                android:text="• POPULAR NOW" />
        </LinearLayout>

        <!-- Shelf Cards Row: 4 curated popular recommendations (filled in code) -->
        <LinearLayout
            android:id="@+id/shelfCardsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="10dp"
            android:paddingBottom="14dp"
            android:clipChildren="false"
            android:clipToPadding="false" />
    </LinearLayout>

    <!-- Main Content Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="36dp"
        android:paddingEnd="36dp"
        android:paddingTop="18dp">

        <!-- Top Bar: Clock, Greeting, Inputs, Wi-Fi, Settings -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/leftBlock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/greeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:textColor="#66FFFFFF"
                    android:textSize="10sp"
                    android:fontFamily="@font/outfit"
                    android:fontVariationSettings="'wght' 500"
                    android:letterSpacing="0.18"
                    android:textAllCaps="true" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="bottom">

                    <TextClock
                        android:id="@+id/clock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:format12Hour="h:mm"
                        android:format24Hour="HH:mm"
                        android:textColor="#FFFFFFFF"
                        android:textSize="38sp"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 300"
                        android:letterSpacing="-0.03"
                        android:includeFontPadding="false" />

                    <TextClock
                        android:id="@+id/ampm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:layout_gravity="bottom"
                        android:layout_marginBottom="4dp"
                        android:format12Hour="a"
                        android:format24Hour=""
                        android:textColor="#99FFFFFF"
                        android:textSize="11sp"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 500"
                        android:letterSpacing="0.06"
                        android:textAllCaps="true" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="18dp"
                        android:layout_gravity="bottom"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"
                        android:layout_marginBottom="5dp"
                        android:background="#26FFFFFF" />

                    <TextClock
                        android:id="@+id/date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:layout_marginBottom="5dp"
                        android:format12Hour="EEEE  d MMMM"
                        android:format24Hour="EEEE  d MMMM"
                        android:textColor="#80FFFFFF"
                        android:textSize="11sp"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 400"
                        android:letterSpacing="0.08"
                        android:textAllCaps="true" />
                </LinearLayout>
            </LinearLayout>

            <!-- Quick Action Pills -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignBottom="@id/leftBlock"
                android:layout_marginBottom="4dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnInputs"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="@drawable/pill_bg"
                    android:drawableStart="@drawable/ic_input"
                    android:drawablePadding="6dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="14dp"
                    android:text="@string/inputs"
                    android:textColor="@drawable/pill_text"
                    android:textSize="12sp"
                    android:fontFamily="@font/outfit"
                    android:fontVariationSettings="'wght' 500" />

                <TextView
                    android:id="@+id/btnWifi"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/pill_bg"
                    android:drawableStart="@drawable/ic_wifi"
                    android:drawablePadding="6dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="14dp"
                    android:text="@string/wifi"
                    android:textColor="@drawable/pill_text"
                    android:textSize="12sp"
                    android:fontFamily="@font/outfit"
                    android:fontVariationSettings="'wght' 500" />

                <TextView
                    android:id="@+id/btnSettings"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/pill_bg"
                    android:drawableStart="@drawable/ic_settings"
                    android:drawablePadding="6dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="14dp"
                    android:text="@string/settings"
                    android:textColor="@drawable/pill_text"
                    android:textSize="12sp"
                    android:fontFamily="@font/outfit"
                    android:fontVariationSettings="'wght' 500" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Apps Grid: Dock row is parked at bottom, scroll down reveals all apps -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingTop="6dp"
                android:paddingBottom="24dp"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:overScrollMode="never"
                android:scrollbars="none" />
        </FrameLayout>
    </LinearLayout>

    <!-- Glass Highlight: floats and glides smoothly across focused tiles -->
    <com.gathin.tvhome.GlassView
        android:id="@+id/glass"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0" />
</FrameLayout>
